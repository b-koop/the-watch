{
  "name": "@ai-local/watch",
  "version": "1.1.3",
  "description": "Pi package that watches pull requests with PR-aware /vette, /pr, /watch, and /peek commands plus GitHub status diagnostics.",
  "type": "module",
  "license": "MIT",
  "author": "b-koop",
  "repository": {
    "type": "git",
    "url": "https://github.com/b-koop/the-watch"
  },
  "homepage": "https://github.com/b-koop/the-watch#readme",
  "bugs": {
    "url": "https://github.com/b-koop/the-watch/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pr-review",
    "code-review",
    "github",
    "vette",
    "watch",
    "claude-code",
    "claude-code-plugin"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions/",
    "scripts/",
    "README.md",
    "skills/",
    "workflows/",
    ".claude-plugin/"
  ],
  "pi": {
    "extensions": [
      "./extensions/pr-vette.ts",
      "./extensions/gh-status/extension.ts"
    ]
  },
  "dependencies": {
    "smart-model-run": "^0.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "^0.75.4",
    "@types/node": "^25.9.2",
    "typebox": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:console",
    "lint:console": "node scripts/lint-no-console.mjs",
    "test": "pnpm typecheck && vitest run",
    "vitest": "vitest run",
    "vette:review": "node --experimental-strip-types scripts/vette-review.ts",
    "post-vette-comments": "node --experimental-strip-types scripts/post-vette-comments.ts",
    "prepublishOnly": "pnpm typecheck",
    "pack:check": "npm pack --dry-run",
    "publish:ci": "npm publish --provenance --access public",
    "publish:otc": "./scripts/publish-npm.sh",
    "vette:prepare": "node --experimental-strip-types scripts/vette-prepare.ts"
  }
}
